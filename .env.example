# AUREVIA Luxury Fragrance — Environment Configuration
# Copy this file to .env and replace placeholders with your Firebase credentials

# Firebase Web App Credentials (from Firebase Console -> Project Settings -> General -> Your apps)
VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyHere1234567890"
VITE_FIREBASE_AUTH_DOMAIN="aurevia-luxury.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="aurevia-luxury"
VITE_FIREBASE_STORAGE_BUCKET="aurevia-luxury.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Optional Cloud Functions API URL for authoritative backend total calculations
VITE_FUNCTIONS_BASE_URL="https://us-central1-aurevia-luxury.cloudfunctions.net"

# Store Currency & Market Default
VITE_STORE_CURRENCY="USD"
VITE_STORE_LOCALE="en-US"
VITE_SHIPPING_DEFAULT_COUNTRY="US"
